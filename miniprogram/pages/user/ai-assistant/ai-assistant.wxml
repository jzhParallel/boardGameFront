<view class="chat-page">
  <!-- 顶部提示 -->
  <view class="disclaimer">
    <view class="disclaimer-mark"></view>
    <text>AI 解答仅供参考，具体规则以店内说明为准</text>
  </view>

  <!-- 消息列表 -->
  <scroll-view
    class="message-list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-top="{{scrollTop}}"
    scroll-with-animation
  >
    <view class="messages-inner">
      <chat-bubble
        wx:for="{{messages}}"
        wx:key="id"
        type="{{item.type}}"
        role="{{item.role}}"
        content="{{item.content}}"
        user-avatar="{{userAvatar}}"
        game-name="{{item.gameName}}"
        game-players="{{item.gamePlayers}}"
        game-difficulty="{{item.gameDifficulty}}"
        bind:cardtap="onCardTap"
      />
    </view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area safe-bottom">
    <view class="input-wrap">
      <input
        class="msg-input"
        placeholder="{{isTyping ? 'AI 正在整理答案...' : '问我桌游规则、推荐或位置'}}"
        value="{{inputValue}}"
        bindinput="onInput"
        bindconfirm="onSend"
        confirm-type="send"
        disabled="{{isTyping}}"
        cursor-spacing="24"
        aria-label="输入桌游问题"
      />
      <button
        class="send-btn {{canSend ? 'active' : ''}} {{isTyping ? 'typing' : ''}}"
        bindtap="onSend"
        disabled="{{!canSend}}"
        hover-class="send-btn--pressed"
        hover-stay-time="80"
        aria-label="发送问题"
      >
        <text>{{isTyping ? '等待' : '发送'}}</text>
      </button>
    </view>
  </view>
</view>
