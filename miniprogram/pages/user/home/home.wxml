<scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="store-header">
    <view class="store-info">
      <picker mode="selector" range="{{storeNames}}" value="{{selectedStoreIndex}}" bindchange="onStoreChange">
        <view class="store-title">
          <text class="store-name">{{store.storeName || '桌游空间'}}</text>
          <view class="store-switch-icon">
            <text>⇄</text>
          </view>
        </view>
      </picker>
      <view class="store-meta">
        <text class="meta-item">{{store.address || '加载中...'}}</text>
      </view>
      <view class="store-meta">
        <text class="meta-item">营业时间：{{store.openTime || '10:00'}}-{{store.closeTime || '22:00'}}</text>
      </view>
      <view class="store-meta">
        <text class="meta-item">电话：{{store.phone || '-'}}</text>
      </view>
    </view>
    <view class="store-badge">
      <image wx:if="{{store.storeAvatar}}" class="store-avatar" src="{{store.storeAvatar}}" mode="aspectFill" />
      <text wx:else class="badge-icon">♟</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title"><text>快捷入口</text></view>
    <view class="quick-actions">
      <view
        wx:for="{{quickActions}}"
        wx:key="text"
        class="action-item"
        data-path="{{item.path}}"
        bindtap="onQuickAction"
      >
        <view class="action-icon">
          <text>{{item.icon}}</text>
        </view>
        <text class="action-text">{{item.text}}</text>
      </view>
    </view>
  </view>
</scroll-view>
