<scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <block wx:if="{{game}}">
    <!-- 封面 -->
    <view class="cover-section">
      <image wx:if="{{game.coverImage}}" class="cover-img" src="{{game.coverImage}}" mode="aspectFill" />
      <view wx:else class="cover-placeholder">
        <text class="placeholder-icon">♟</text>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="info-card">
      <text class="game-name">{{game.gameName}}</text>
      <view class="tags-row">
        <view class="tag tag-primary">{{game.category}}</view>
        <view class="tag">{{game.minPlayers}}-{{game.maxPlayers}}人</view>
        <view class="tag">{{game.playTime}}分钟</view>
        <view class="tag">{{game.minAge}}岁+</view>
      </view>
      <view class="difficulty-row">
        <text class="label">难度：</text>
        <text wx:for="{{stars}}" wx:key="index" class="star {{item ? 'filled' : ''}}">★</text>
      </view>
    </view>

    <!-- 规则简介 -->
    <view class="section-card">
      <text class="section-title">规则简介</text>
      <text class="description">{{game.description || '暂无简介'}}</text>
    </view>

    <!-- 店内信息 -->
    <view class="section-card">
      <text class="section-title">店内信息</text>
      <view class="store-info-row">
        <text class="info-label">存放位置</text>
        <text class="info-value">{{storeGame.location || '暂无位置信息'}}</text>
      </view>
      <view class="store-info-row">
        <text class="info-label">库存数量</text>
        <text class="info-value {{storeGame && storeGame.quantity > 0 ? 'available' : 'unavailable'}}">
          {{storeGame ? (storeGame.quantity > 0 ? '可借 (' + storeGame.quantity + '套)' : '暂无库存') : '未收录'}}
        </text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-area">
      <button class="btn-secondary ask-btn" bindtap="onAskAI">
        ✦ 问问AI怎么玩
      </button>
    </view>
  </block>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <text>加载中...</text>
  </view>
</scroll-view>
