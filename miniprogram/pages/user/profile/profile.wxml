<scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="profile-header">
    <view class="avatar-wrap {{uploadingAvatar ? 'uploading' : ''}}" bindtap="onUploadAvatar" hover-class="avatar-wrap--pressed" hover-stay-time="80" aria-label="更换头像">
      <image wx:if="{{avatar}}" class="avatar-image" src="{{avatar}}" mode="aspectFill" />
      <text wx:else class="avatar-text">{{nickname[0] || '游'}}</text>
      <view class="avatar-edit-mark"></view>
    </view>
    <text class="nickname">{{nickname}}</text>
    <text class="avatar-tip">{{uploadingAvatar ? '上传中...' : '点击头像可更换'}}</text>
  </view>

  <view class="staff-entry" wx:if="{{showStaffEntry}}" bindtap="onGoStaff" hover-class="staff-entry--pressed" hover-stay-time="80">
    <view class="entry-icon entry-icon-workbench"></view>
    <text class="entry-text">店员工作台</text>
    <view class="entry-arrow"></view>
  </view>
  <view class="staff-entry" wx:else bindtap="onStaffLogin" hover-class="staff-entry--pressed" hover-stay-time="80">
    <view class="entry-icon entry-icon-login"></view>
    <text class="entry-text">店员登录</text>
    <view class="entry-arrow"></view>
  </view>

  <view class="section">
    <view class="section-title"><text>我的预约</text></view>
    <view wx:if="{{orders.length}}" class="order-list">
      <view wx:for="{{orders}}" wx:key="id" class="order-card">
        <view class="order-top">
          <text class="order-name">{{item.customerName}}</text>
          <text class="order-status status-{{item.status}}">{{statusMap[item.status]}}</text>
        </view>
        <view class="order-info">
          <text class="order-info-label">时间</text>
          <text>{{item.startTime}} ~ {{item.endTime}}</text>
        </view>
        <view class="order-info" wx:if="{{item.remark}}">
          <text class="order-info-label">备注</text>
          <text>{{item.remark}}</text>
        </view>
      </view>
    </view>
    <empty-state wx:else text="暂无预约记录，快去预约吧" icon="□" btn-text="去预约" />
  </view>

  <view class="logout-area">
    <view class="logout-btn" bindtap="onLogout" hover-class="logout-btn--pressed" hover-stay-time="80">
      <text>退出登录</text>
    </view>
  </view>
</scroll-view>
