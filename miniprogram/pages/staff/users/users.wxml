<scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="user-list" wx:if="{{customers.length}}">
    <view wx:for="{{customers}}" wx:key="name" class="user-card">
      <view class="user-avatar">
        <text>{{item.name[0]}}</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{item.name}}</text>
        <text class="user-meta">预约 {{item.orderCount}} 次 · 最近 {{item.lastOrder}}</text>
      </view>
    </view>
  </view>

  <empty-state wx:if="{{!customers.length && !loading}}" text="暂无顾客记录" icon="👥" />
</scroll-view>
