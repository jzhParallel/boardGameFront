<view class="time-grid">
  <view class="grid-header">
    <text class="hint">点击选择时段（可连选）</text>
    <view class="legend">
      <view class="legend-item"><view class="dot available"></view><text>空闲</text></view>
      <view class="legend-item"><view class="dot occupied"></view><text>已占用</text></view>
      <view class="legend-item"><view class="dot reserved"></view><text>我已预约</text></view>
      <view class="legend-item"><view class="dot selected"></view><text>我已选择</text></view>
    </view>
  </view>
  <view class="grid-body">
    <view
      wx:for="{{slots}}"
      wx:key="time"
      class="slot {{item.status}}"
      data-index="{{index}}"
      bindtap="onSlotTap"
    >
      <text>{{item.time}}</text>
    </view>
  </view>
  <view wx:if="{{selectedStart}}" class="selection-info">
    <text>我已选择：{{selectedStart}} - {{selectedEnd || '请选择结束时段'}}</text>
  </view>
</view>
